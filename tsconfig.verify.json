{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"incremental": false
	},
	"include": [
		"next-env.d.ts",
		"app/**/*.ts",
		"app/**/*.tsx",
		"components/**/*.ts",
		"components/**/*.tsx",
		"db/**/*.ts",
		"lib/**/*.ts",
		"lib/**/*.tsx",
		"store/**/*.ts",
		"types/**/*.ts"
	],
	"exclude": ["node_modules", ".next", "misc"]
}
