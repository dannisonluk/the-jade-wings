{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"incremental": false
	},
	"include": [
		"next-env.d.ts",
		"app/**/*.ts",
		"app/**/*.tsx",
		"components/**/*.ts",
		"components/**/*.tsx",
		"data/**/*.ts",
		"features/**/*.ts",
		"features/**/*.tsx",
		"i18n/**/*.ts",
		"lib/**/*.ts",
		"lib/**/*.tsx"
	],
	"exclude": ["node_modules", ".next", "archive"]
}
